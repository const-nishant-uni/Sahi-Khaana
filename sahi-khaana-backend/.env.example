# Copy to .env and fill in. Never commit .env.

# Groq API key (used only to phrase explanations; it never decides anything).
# Leave empty to use the built-in template explanation.
GROQ_API_KEY=
# Chat model used to word explanations. Groq retires models (the old Llama ids now return 404
# "model_not_found"), so if explanations stop coming back as "llm", list what your key can use:
#   curl -s https://api.groq.com/openai/v1/models -H "Authorization: Bearer $GROQ_API_KEY"
# Avoid openai/gpt-oss-* here: they use the small token limit on hidden reasoning and return empty text.
GROQ_MODEL=qwen/qwen3.8-27b

# Optional overrides (defaults shown)
# MAX_UPLOAD_BYTES=5242880
# BLUR_THRESHOLD=60
# MATCH_CONFIDENCE_CUTOFF=0.90
# MIN_TEXT_HEIGHT_PX=30
# IMAGE_RETENTION_DAYS=7
