# Copy to .env and fill in. Never commit .env.

# Groq API key (used only to phrase explanations; it never decides anything).
# Leave empty to use the built-in template explanation.
GROQ_API_KEY=
# Any chat model id from https://console.groq.com/docs/models (check the list; ids change).
GROQ_MODEL=llama-3.1-8b-instant

# Optional overrides (defaults shown)
# MAX_UPLOAD_BYTES=5242880
# BLUR_THRESHOLD=60
# MATCH_CONFIDENCE_CUTOFF=0.90
# MIN_TEXT_HEIGHT_PX=30
# IMAGE_RETENTION_DAYS=7
